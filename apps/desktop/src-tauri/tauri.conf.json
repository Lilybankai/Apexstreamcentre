{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApexStreamCentre",
  "version": "0.1.0",
  "identifier": "co.apexstreamcentre.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ApexStreamCentre Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
