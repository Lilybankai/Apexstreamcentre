# Copy to infra/.env to configure the chat-aggregator connectors.

# Read Twitch chat from this channel login (anonymous, no credentials needed):
TWITCH_CHANNEL=

# Set to 1 to also emit synthetic demo events (chat/follow/sub/raid) every 3s.
# Great for verifying the overlays + chat dock with zero platform setup.
SYNTHETIC=1

# Placeholders for P4 (OAuth) connectors:
YOUTUBE_CHANNEL=
KICK_CHANNEL=
